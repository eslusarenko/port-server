# port-server configuration file
#
# Lines are KEY=VALUE. Lines starting with '#' and blank lines are ignored.
# Unknown keys are skipped with a warning.
#
# Lookup: by default, port-server reads "port-server.conf" from the directory
# of the binary. Override with: port-server --config /path/to/file.conf
#
# Resolution priority (lowest -> highest):
#   defaults -> config file -> CLI flags -> environment variables
# Env variables always win, so orchestration (k8s, systemd) can override
# everything without editing this file.
#
# Every setting can equivalently be passed as a CLI flag (see --help) or
# exported in the environment with the same key name.

# Listen address. Default: ":8080"
#PORT_ADDR=:8080

# Base domain assigned to tunnel subdomains. Default: "tunnel.localhost"
#PORT_BASE_DOMAIN=tunnel.localhost

# How long an idle tunnel stays alive. Default: "24h"
#PORT_TUNNEL_TTL=24h

# Log verbosity: debug | info | warn | error. Default: "info"
#PORT_LOG_LEVEL=info

# Log format: plain | json | silent. Default: "plain"
#PORT_LOG_TYPE=plain

# Write logs to this file instead of stderr. Empty = stderr. Default: ""
#PORT_LOG_FILENAME=

# Max request body size in bytes. Default: 10485760 (10 MB)
#PORT_MAX_BODY_SIZE=10485760

# WebSocket ping interval. Default: "30s"
#PORT_PING_INTERVAL=30s

# WebSocket ping timeout. Default: "1m30s"
#PORT_PING_TIMEOUT=1m30s

# Trust X-Forwarded-For / X-Real-IP from a reverse proxy or ingress.
# Enable only when port-server is NOT directly reachable from the internet.
# Default: false
#PORT_TRUST_PROXY_HEADERS=false

# MySQL DSN for API-key authentication and user management.
# Required unless --allow-unauthed is set. Default: "" (unset = auth disabled)
#PORT_DB_DSN=user:pass@tcp(127.0.0.1:3306)/port?parseTime=true

# Run in legacy unauthenticated mode when no DB is configured.
# When set to true, tunnels are accepted without any API key.
# Has no effect when PORT_DB_DSN is set (auth is always enforced with a DB).
# Default: false
#PORT_ALLOW_UNAUTHED=false

# TTL cap applied to unauthenticated tunnels. Effective TTL = min(PORT_TUNNEL_TTL, PORT_UNAUTHED_TTL).
# Only enforced when PORT_ALLOW_UNAUTHED=true and PORT_NO_UNAUTHED_RESTRICTIONS is not set.
# Default: "2h"
#PORT_UNAUTHED_TTL=2h

# Comma-separated list of subdomains that cannot be requested via --domain.
# Applied to both authed and unauthed tunnels (defense-in-depth).
# Operator-supplied — no built-in defaults. Empty list = no enforcement.
# Recommended baseline for public deployments:
#PORT_RESERVED_SUBDOMAINS=admin,login,dashboard,billing,support,donate,office,api,www,mail,status,auth,account,accounts,secure,portal,help,docs,pay,payment,payments,shop,store

# When true, removes the TTL cap and --domain block for unauthenticated tunnels.
# Use for single-operator deployments where unauthed == trusted.
# Default: false
#PORT_NO_UNAUTHED_RESTRICTIONS=false
